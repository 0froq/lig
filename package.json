{
  "name": "lig",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet product site template: paper, one pen line and a handwritten sentence.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "vp run ports:generate && nuxt build",
    "generate": "vp run ports:generate && nuxt generate",
    "deploy": "void deploy --platform cloudflare",
    "preview": "nuxt preview",
    "preview:deploy": "pnpm generate && cf previews deploy",
    "lint": "vp lint --config .oxlintrc.json .",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix",
    "fmt": "vp fmt --config .oxfmtrc.json .",
    "fmt:check": "vp fmt --config .oxfmtrc.json . --check",
    "check": "vp run lint && vp run fmt:check && vp run typecheck",
    "typecheck": "nuxt typecheck",
    "palette:generate": "pnpm tokens:generate",
    "postinstall": "nuxt prepare",
    "prepare": "npx simple-git-hooks",
    "tokens:generate": "jiti core/scripts/generate.ts",
    "tokens:check": "jiti core/scripts/generate.ts --check",
    "test": "vp run ports:generate && vp test --config tooling/vite.config.ts",
    "tokens:test": "vp test --config tooling/vite.config.ts core/tests",
    "tokens:typecheck": "tsc --project core/tsconfig.json",
    "syntax:generate": "jiti syntax/scripts/generate.ts",
    "syntax:check": "jiti syntax/scripts/generate.ts --check",
    "syntax:test": "vp test --config tooling/vite.config.ts syntax/tests",
    "syntax:typecheck": "tsc --project syntax/tsconfig.json",
    "ports:generate": "jiti ports/compile.ts",
    "ports:check": "jiti ports/compile.ts --check",
    "ports:typecheck": "tsc --project ports/tsconfig.json",
    "ports:test": "vp test --config tooling/vite.config.ts ports/contracts.test.ts",
    "check:core": "vp run tokens:typecheck && vp run tokens:test && vp run tokens:check && vp run syntax:typecheck && vp run syntax:test && vp run syntax:check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:prod",
    "@fontsource-variable/geist-mono": "catalog:prod",
    "@fontsource/instrument-serif": "catalog:prod",
    "@froq/og-covers-layer": "catalog:prod",
    "@froq/ui": "file:vendor/ui",
    "@nuxt/content": "catalog:prod",
    "@nuxtjs/i18n": "catalog:prod",
    "@shikijs/langs": "catalog:prod",
    "nuxt": "catalog:prod",
    "shiki": "catalog:prod",
    "vue": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "cf": "catalog:dev",
    "into-the-void": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:dev",
    "nuxtseo-devtools-host": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev",
    "void": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "vp lint --config .oxlintrc.json --fix --no-error-on-unmatched-pattern",
      "vp fmt --config .oxfmtrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^24.21.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
