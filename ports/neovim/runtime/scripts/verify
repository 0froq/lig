#!/usr/bin/env python3
"""Verify the generated native distribution; does not check visual rendering."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
manifest = json.loads((root / 'lig-build.json').read_text())
assert manifest['port'] == 'neovim'
assert manifest['distributionRepository'] == 'https://github.com/0froq/lig.nvim'
for name, expected in manifest['files'].items():
    path = (root / name).resolve()
    assert path.is_relative_to(root), f'Artifact outside distribution: {name}'
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    assert actual == expected, f'Artifact checksum mismatch: {name}'
print(f"Verified {len(manifest['files'])} generated artifact checksums", flush=True)
with tempfile.TemporaryDirectory(prefix='lig-nvim-verify-') as cache:
    subprocess.run([
        'nvim', '--headless', '-u', 'NONE', '-i', 'NONE', '--noplugin',
        '-l', str(root / 'scripts/verify.lua'),
    ], cwd=root, env={**os.environ, 'XDG_CACHE_HOME': cache}, check=True)
